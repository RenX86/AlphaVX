# ============================================
# AlphaVX Environment Configuration
# ============================================
# Copy this file to .env.alphavx and fill in your values:
#   cp .env.example .env.alphavx
#
# We use ".env.alphavx" instead of ".env" because anndata
# (an alphagenome dependency) auto-reads ".env" and crashes
# on unknown keys.
#
# NEVER commit .env.alphavx to git — it contains your API key.
# ============================================

# Required: Your AlphaGenome API key
# Sign up at: https://deepmind.google.com/science/alphagenome/
ALPHAVX_API_KEY=your-alphagenome-api-key-here

# Optional: Override default settings
# ALPHAVX_MAX_RETRIES=3
# ALPHAVX_RETRY_DELAY=5.0
# ALPHAVX_SEQUENCE_LENGTH=1048576
# ALPHAVX_QUANTILE_THRESHOLD=0.995
